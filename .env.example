# SmartInterview — Environment Variables

# Groq AI (existing)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# MySQL Database
DATABASE_URL=mysql+pymysql://root:root@localhost:3306/smartinterview

# JWT Authentication
# WARNING: Generate a secure 64+ char random hex string in production. Do NOT use predictable values.
JWT_SECRET_KEY=change-this-to-a-random-64-char-hex-string
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440
